[Unit]
Description=AgentBridge restricted HTTPS CONNECT proxy
After=network.target
[Service]
User=agentbridge-proxy
Group=agentbridge-proxy
ExecStart=/usr/bin/python3 /opt/agentbridge-worker/proxy.py
Restart=on-failure
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
TasksMax=64
MemoryMax=128M
StandardOutput=null
StandardError=null
[Install]
WantedBy=multi-user.target
